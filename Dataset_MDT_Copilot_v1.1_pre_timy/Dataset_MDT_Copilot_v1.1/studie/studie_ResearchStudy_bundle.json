    {
      "fullUrl": "https://rakathon.example.org/fhir/ResearchStudy/RKT-06",
      "resource": {
        "resourceType": "ResearchStudy",
        "id": "RKT-06",
        "identifier": [
          {
            "system": "https://rakathon.example.org/fhir/sid/studie",
            "value": "RKT-06"
          }
        ],
        "title": "ORION-HRR – PARP inhibitor (RKT-PARPi) u pokročilých solidních nádorů s patogenní alterací genů homologní rekombinace (HRR) v nádoru",
        "status": "active",
        "phase": {
          "text": "II (basket)"
        },
        "condition": [
          {
            "text": "Pokročilé solidní nádory s alterací BRCA1/2 nebo jiného HRR genu"
          }
        ],
        "description": "Kritéria zařazení:\nZ1: Patogenní alterace BRCA1, BRCA2 nebo jiného HRR genu prokázaná NGS v nádoru (somatická nebo zárodečná)\nZ2: Alespoň 1 předchozí linie systémové léčby v metastatickém stadiu\nZ3: ECOG 0–1\nZ4: Hemoglobin ≥ 90 g/l, neutrofily ≥ 1,5 × 10^9/l, trombocyty ≥ 100 × 10^9/l při zařazení\n\nKritéria vyřazení:\nV1: Předchozí léčba PARP inhibitorem\nV2: Myelodysplastický syndrom nebo akutní myeloidní leukémie v anamnéze\nV3: Neléčené mozkové metastázy\n\nPravidla protokolu:\nÚprava dávky podle protokolu: hemoglobin < 80 g/l → přerušit podávání, transfuze dle potřeby, po úpravě na ≥ 90 g/l pokračovat se sníženou dávkou (250 mg 2× denně, další redukce 200 mg 2× denně). Anémie G3 při nejnižší dávce (200 mg 2× denně) → ukončení studijní léčby.",
        "arm": [
          {
            "name": "Rameno 1",
            "description": "RKT-PARPi 300 mg p. o. 2× denně, cyklus 28 dní (jediné rameno)"
          }
        ],
        "enrollment": [
          {
            "reference": "Group/RKT-06-kriteria",
            "display": "kritéria – viz description a Group.characteristic"
          }
        ]
      }
    },
