    {
      "fullUrl": "https://rakathon.example.org/fhir/ResearchStudy/RKT-03",
      "resource": {
        "resourceType": "ResearchStudy",
        "id": "RKT-03",
        "identifier": [
          {
            "system": "https://rakathon.example.org/fhir/sid/studie",
            "value": "RKT-03"
          }
        ],
        "title": "COLUMBA-LM – Resekce jater s peroperační ultrazvukovou navigací a ablací drobných ložisek vs. standardní resekce u kolorektálních jaterních metastáz po indukční chemoterapii",
        "status": "active",
        "phase": {
          "text": "III"
        },
        "condition": [
          {
            "text": "Kolorektální karcinom s jaterními metastázami"
          }
        ],
        "description": "Kritéria zařazení:\nZ1: Metastázy kolorektálního karcinomu omezené na játra\nZ2: Odpověď nebo stabilizace po ≥ 6 cyklech indukční chemoterapie s oxaliplatinou nebo irinotekanem\nZ3: ECOG 0–1\nZ4: Resekabilita potvrzená MDT s hepatobiliárním chirurgem\n\nKritéria vyřazení:\nV1: Extrahepatální onemocnění\nV2: MSI-H / dMMR\nV3: Periferní neuropatie ≥ G2\nV4: Předpokládaný budoucí jaterní remnant (FLR) < 30 %",
        "arm": [
          {
            "name": "Rameno 1",
            "description": "resekce + navigace + ablace ložisek ≤ 15 mm"
          },
          {
            "name": "Rameno 2",
            "description": "standardní resekce"
          }
        ],
        "enrollment": [
          {
            "reference": "Group/RKT-03-kriteria",
            "display": "kritéria – viz description a Group.characteristic"
          }
        ]
      }
    },
