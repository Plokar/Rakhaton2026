# =============================================================================
# .env.dev.example – Alias pro .env.example (vývojové prostředí)
# Zkopírujte do .env
# =============================================================================
# Viz .env.example pro kompletní seznam proměnných.

DJANGO_SECRET_KEY=dev-secret-key-change-in-production-min-50-chars-long
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings_dev
ALLOWED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_DB=appdb_dev
POSTGRES_USER=appuser
POSTGRES_PASSWORD=devpassword123
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://:devredispass@redis:6379
REDIS_PASSWORD=devredispass

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=Hackathon Template (DEV)
NEXT_PUBLIC_APP_VERSION=dev

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@hackathon.local
DJANGO_SUPERUSER_PASSWORD=admin123456

EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@hackathon.local

# AI (T-323): LLM = AI_PROVIDER (nvidia | gemini | mock), vektory v IRIS = EMBEDDING_PROVIDER (výchozí = LLM),
# přepis audia = TRANSCRIBE_PROVIDER (výchozí groq, je-li GROQ_API_KEY). Bez klíče provider spadne na mock.
# Klíče jen sem (lokální .env), nikdy do gitu. Free tiery jen nad syntetickým datasetem (D-021).
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBEDDING_DIM=2048
# NVIDIA_THINKING=1     # přemýšlení modelu: přesnější, ~3× pomalejší (NFR-1 < 20 s)
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3
# EMBEDDING_PROVIDER=gemini   # jiný embedding = jiná dimenze → vektory se přepočítají (ingest_dataset --skip-fhir)
# D-021: data skutečných pacientů (bez tagu fiktivni-data) do LLM jen s placeným tierem → True
AI_REAL_PATIENT_DATA=False
GEMINI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_MODEL_STRONG=gemini-4-argon
# Chatbot (T-338): s OPENAI_API_KEY jede přes Azure OpenAI gateway týmu (jen syntetická data), klíč nikdy do gitu.
OPENAI_BASE_URL=https://apim-rakathon-q7146n.azure-api.net/openai/v1
OPENAI_API_KEY=
# CHATBOT_MODEL=gpt-6-1-sol-dz-eu
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536
TRANSCRIBE_MODEL=gemini-3.8-flash
