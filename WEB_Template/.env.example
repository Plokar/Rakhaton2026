# =============================================================================
# .env.example – Šablona pro vývojové prostředí
# Zkopírujte do .env a vyplňte hodnoty
# =============================================================================

# ── Django Backend ────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=dev-secret-key-change-in-production-min-50-chars-long
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings_dev
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
POSTGRES_DB=appdb_dev
POSTGRES_USER=appuser
POSTGRES_PASSWORD=devpassword123
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Cache & Message Broker (Redis) ────────────────────────────────────────────
REDIS_URL=redis://:devredispass@redis:6379
REDIS_PASSWORD=devredispass

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=Hackathon Template
NEXT_PUBLIC_APP_VERSION=1.0.0

# ── Superuser (pouze dev – automatické vytvoření) ─────────────────────────────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@hackathon.local
DJANGO_SUPERUSER_PASSWORD=admin123456

# ── Email (Mailhog v dev) ─────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@hackathon.local

# =============================================================================
# VOLITELNÉ SLUŽBY – Odkomentovat pokud používáte
# =============================================================================

# ── Qdrant (Vector Database) ──────────────────────────────────────────────────
# QDRANT_HOST=qdrant
# QDRANT_PORT=6333
# QDRANT_API_KEY=                    # Prázdné = bez autentizace (dev)
# QDRANT_COLLECTION=hackathon_vectors

# ── Celery ────────────────────────────────────────────────────────────────────
# CELERY_BROKER_URL=redis://:devredispass@redis:6379/1
# CELERY_RESULT_BACKEND=redis://:devredispass@redis:6379/1

# ── MinIO (S3-compatible storage) ────────────────────────────────────────────
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_STORAGE_BUCKET_NAME=hackathon-bucket
# AWS_S3_ENDPOINT_URL=http://minio:9000

# ── OpenAI / AI ──────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Sentry ────────────────────────────────────────────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...

# ── Flower (Celery monitoring) ────────────────────────────────────────────────
# FLOWER_USER=admin
# FLOWER_PASSWORD=flowerpassword
