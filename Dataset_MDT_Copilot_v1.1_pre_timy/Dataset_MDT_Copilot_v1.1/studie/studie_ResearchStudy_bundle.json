    {
      "fullUrl": "https://rakathon.example.org/fhir/ResearchStudy/RKT-02",
      "resource": {
        "resourceType": "ResearchStudy",
        "id": "RKT-02",
        "identifier": [
          {
            "system": "https://rakathon.example.org/fhir/sid/studie",
            "value": "RKT-02"
          }
        ],
        "title": "HELIX-2 – Nový anti-HER2 protilátkový konjugát (RKT-ADC2) vs. léčba dle výběru lékaře u HER2+ metastatického karcinomu prsu po trastuzumabu a taxanu, včetně pacientek s mozkovými metastázami",
        "status": "active",
        "phase": {
          "text": "III"
        },
        "condition": [
          {
            "text": "Karcinom prsu, HER2+, metastatický"
          }
        ],
        "description": "Kritéria zařazení:\nZ1: HER2 pozitivní karcinom prsu (IHC 3+ nebo ISH pozitivní) z primárního nádoru nebo metastázy\nZ2: Progrese po předchozí léčbě trastuzumabem a taxanem v metastatickém stadiu\nZ3: Mozkové metastázy povoleny: léčené a stabilní, nebo neléčené asymptomatické nevyžadující kortikoidy v dávce > 2 mg dexametazonu denně\nZ4: ECOG 0–1\nZ5: LVEF ≥ 50 %\n\nKritéria vyřazení:\nV1: Intersticiální plicní onemocnění nebo pneumonitida v anamnéze\nV2: Předchozí léčba trastuzumab deruxtekanem\nV3: Leptomeningeální postižení",
        "arm": [
          {
            "name": "Rameno 1",
            "description": "RKT-ADC2 i.v. á 3 týdny"
          },
          {
            "name": "Rameno 2",
            "description": "léčba dle výběru lékaře (trastuzumab deruxtekan nebo tukatinib + trastuzumab + kapecitabin)"
          }
        ],
        "enrollment": [
          {
            "reference": "Group/RKT-02-kriteria",
            "display": "kritéria – viz description a Group.characteristic"
          }
        ]
      }
    },
