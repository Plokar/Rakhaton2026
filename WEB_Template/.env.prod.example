# =============================================================================
# .env.prod.example – Šablona pro PRODUKČNÍ prostředí
# DŮLEŽITÉ: Nikdy necommitujte reálné produkční hodnoty!
# =============================================================================

# ── Django Backend ────────────────────────────────────────────────────────────
# Generovat: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE-ME-TO-LONG-RANDOM-STRING-AT-LEAST-50-CHARS
DJANGO_DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings_prod
# MDT Copilot (ARCH §3.4): backend na api.<doména>, frontend na Vercelu volá /api přes rewrites
API_DOMAIN=api.yourdomain.com
ALLOWED_HOSTS=api.yourdomain.com
# Vercel: produkční URL + preview deploye (wildcard jen pro hackathon)
CORS_ALLOWED_ORIGINS=https://mdt-copilot.vercel.app
CSRF_TRUSTED_ORIGINS=https://mdt-copilot.vercel.app,https://*.vercel.app

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
POSTGRES_DB=appdb_prod
POSTGRES_USER=appuser_prod
POSTGRES_PASSWORD=CHANGE-ME-STRONG-DB-PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Cache & Message Broker (Redis) ────────────────────────────────────────────
REDIS_URL=redis://:CHANGE-ME-REDIS-PASSWORD@redis:6379
REDIS_PASSWORD=CHANGE-ME-REDIS-PASSWORD

# ── IRIS for Health (T-005) ───────────────────────────────────────────────────
# Výchozí heslo SYS změní `iris_init` při prvním startu backendu (SuperUser, Admin, _SYSTEM).
# Generovat: python -c "import secrets; print(secrets.token_urlsafe(24))"
IRIS_PASSWORD=CHANGE-ME-IRIS-PASSWORD

# ── MDT demo ─────────────────────────────────────────────────────────────────
# seed_mdt při startu (demo účty, boardy z nominací v IRIS, presety); heslo demo účtů
MDT_SEED=True
MDT_DEMO_PASSWORD=CHANGE-ME-DEMO-PASSWORD
# Demo bez Gemini z uloženého podkladu P03 (data/demo_cache, T-311)
MDT_DEMO_OFFLINE=False

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://yourdomain.com
NEXT_PUBLIC_WS_URL=wss://yourdomain.com
NEXT_PUBLIC_APP_NAME=Hackathon Template
NEXT_PUBLIC_APP_VERSION=1.0.0

# ── Email (SMTP v produkci) ───────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com               # nebo smtp.sendgrid.net, atd.
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=CHANGE-ME-APP-PASSWORD
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ── Traefik ───────────────────────────────────────────────────────────────────
# Nastavit v traefik/traefik.yml: email pro Let's Encrypt

# =============================================================================
# VOLITELNÉ SLUŽBY
# =============================================================================

# ── Qdrant ────────────────────────────────────────────────────────────────────
# QDRANT_HOST=qdrant
# QDRANT_PORT=6333
# QDRANT_API_KEY=CHANGE-ME-QDRANT-API-KEY
# QDRANT_COLLECTION=production_vectors

# ── Celery ────────────────────────────────────────────────────────────────────
# CELERY_BROKER_URL=redis://:CHANGE-ME-REDIS-PASSWORD@redis:6379/1
# CELERY_RESULT_BACKEND=redis://:CHANGE-ME-REDIS-PASSWORD@redis:6379/1
# FLOWER_USER=admin
# FLOWER_PASSWORD=CHANGE-ME-FLOWER-PASSWORD

# ── MinIO ─────────────────────────────────────────────────────────────────────
# MINIO_ROOT_USER=CHANGE-ME-MINIO-USER
# MINIO_ROOT_PASSWORD=CHANGE-ME-MINIO-PASSWORD
# AWS_ACCESS_KEY_ID=CHANGE-ME-MINIO-USER
# AWS_SECRET_ACCESS_KEY=CHANGE-ME-MINIO-PASSWORD
# AWS_STORAGE_BUCKET_NAME=production-bucket
# AWS_S3_ENDPOINT_URL=https://storage.yourdomain.com

# ── AI / Gemini (ARCHITEKTURA §5.7, §9) ──────────────────────────────────────
# Google AI Studio, JEN placený tier (Q9); klíč nikdy do gitu ani do frontendu
AI_PROVIDER=gemini
# D-021: data skutečných pacientů (bez tagu fiktivni-data) do LLM jen s placeným tierem → True
AI_REAL_PATIENT_DATA=False
GEMINI_API_KEY=CHANGE-ME
AI_MODEL=gemini-3.8-flash
AI_MODEL_STRONG=gemini-4-argon
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536
TRANSCRIBE_MODEL=gemini-3.8-flash
# AI_TIMEOUT_S=90
# AI_THINKING_LEVEL=low          # minimal | low | medium | high (latence, NFR-1)

# ── Sentry ────────────────────────────────────────────────────────────────────
# SENTRY_DSN=https://...@o123456.ingest.sentry.io/...
