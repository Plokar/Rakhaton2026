  "entry": [
    {
      "fullUrl": "https://rakathon.example.org/fhir/ResearchStudy/RKT-01",
      "resource": {
        "resourceType": "ResearchStudy",
        "id": "RKT-01",
        "identifier": [
          {
            "system": "https://rakathon.example.org/fhir/sid/studie",
            "value": "RKT-01"
          }
        ],
        "title": "MERIDIAN-B – Perorální selektivní degradátor estrogenového receptoru (RKT-SERD) vs. fulvestrant u ESR1-mutovaného HR+/HER2− metastatického karcinomu prsu po progresi na inhibitoru CDK4/6",
        "status": "active",
        "phase": {
          "text": "II"
        },
        "condition": [
          {
            "text": "Karcinom prsu, HR+/HER2−, metastatický"
          }
        ],
        "description": "Kritéria zařazení:\nZ1: Histologicky ověřený karcinom prsu, ER ≥ 10 %, HER2 negativní (IHC 0, 1+ nebo 2+ s negativní ISH)\nZ2: Mutace ESR1 prokázaná v cirkulující nádorové DNA (ctDNA) ne starší než 3 měsíce\nZ3: Progrese během nebo po 1. linii inhibitor aromatázy + inhibitor CDK4/6 v metastatickém stadiu\nZ4: Nejvýše 1 linie chemoterapie v metastatickém stadiu\nZ5: ECOG 0–1\n\nKritéria vyřazení:\nV1: Viscerální krize\nV2: Neléčené nebo symptomatické mozkové metastázy\nV3: Bilirubin > 1,5× horní hranice normy\nV4: Předchozí léčba fulvestrantem nebo jiným SERD",
        "arm": [
          {
            "name": "Rameno 1",
            "description": "RKT-SERD 400 mg p. o. denně"
          },
          {
            "name": "Rameno 2",
            "description": "fulvestrant 500 mg i.m. (D1, D15, D29, pak á 28 dní)"
          }
        ],
        "enrollment": [
          {
            "reference": "Group/RKT-01-kriteria",
            "display": "kritéria – viz description a Group.characteristic"
          }
        ]
      }
    },
