# =============================================================================
# .env.example – Šablona pro vývojové prostředí
# Zkopírujte do .env a vyplňte hodnoty
# =============================================================================

# ── Django Backend ────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=dev-secret-key-change-in-production-min-50-chars-long
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings_dev
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
POSTGRES_DB=appdb_dev
POSTGRES_USER=appuser
POSTGRES_PASSWORD=devpassword123
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Cache & Message Broker (Redis) ────────────────────────────────────────────
REDIS_URL=redis://:devredispass@redis:6379
REDIS_PASSWORD=devredispass

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=Hackathon Template
NEXT_PUBLIC_APP_VERSION=1.0.0

# ── Superuser (pouze dev – automatické vytvoření) ─────────────────────────────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@hackathon.local
DJANGO_SUPERUSER_PASSWORD=admin123456

# ── Email (Mailhog v dev) ─────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@hackathon.local

# =============================================================================
# VOLITELNÉ SLUŽBY – Odkomentovat pokud používáte
# =============================================================================

# ── Qdrant (Vector Database) ──────────────────────────────────────────────────
# QDRANT_HOST=qdrant
# QDRANT_PORT=6333
# QDRANT_API_KEY=                    # Prázdné = bez autentizace (dev)
# QDRANT_COLLECTION=hackathon_vectors

# ── Celery ────────────────────────────────────────────────────────────────────
# CELERY_BROKER_URL=redis://:devredispass@redis:6379/1
# CELERY_RESULT_BACKEND=redis://:devredispass@redis:6379/1

# ── MinIO (S3-compatible storage) ────────────────────────────────────────────
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_STORAGE_BUCKET_NAME=hackathon-bucket
# AWS_S3_ENDPOINT_URL=http://minio:9000

# ── AI / Gemini (ARCHITEKTURA §5.7, §9) ──────────────────────────────────────
# mock = bez sítě (vývoj, testy, CI); gemini = Google AI Studio, JEN placený tier (Q9)
AI_PROVIDER=mock
# D-021: data skutečných pacientů (bez tagu fiktivni-data) do LLM jen s placeným tierem → True
AI_REAL_PATIENT_DATA=False
# Nikdy do gitu ani do frontendu
GEMINI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_MODEL_STRONG=gemini-4-argon
# Chatbot u zasedání (T-338): Azure OpenAI gateway týmu (jen syntetická data). S OPENAI_API_KEY jede chatbot přes ni,
# jinak přes AI_PROVIDER. Klíč jen v lokálním .env, nikdy do gitu ani do frontendu.
OPENAI_BASE_URL=https://apim-rakathon-q7146n.azure-api.net/openai/v1
OPENAI_API_KEY=
# CHATBOT_PROVIDER=openai        # openai | gemini | mock; bez nastavení openai při OPENAI_API_KEY
# CHATBOT_MODEL=gpt-6-astra      # EU Data Zone deployment: gpt-6-1-sol-dz-eu
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536
TRANSCRIBE_MODEL=gemini-3.8-flash
# AI_TIMEOUT_S=90
# AI_THINKING_LEVEL=low          # minimal | low | medium | high (latence, NFR-1)

# ── Sentry ────────────────────────────────────────────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...

# ── Flower (Celery monitoring) ────────────────────────────────────────────────
# FLOWER_USER=admin
# FLOWER_PASSWORD=flowerpassword
